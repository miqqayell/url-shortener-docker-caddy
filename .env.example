# Copy this file to .env and fill in the values.

# DuckDNS subdomain (must include .duckdns.org)
DOMAIN=your-subdomain.duckdns.org

# Email registered with the ACME account at ZeroSSL.
# Used for cert expiry notifications.
ACME_EMAIL=you@example.com

# DuckDNS API token (find it on https://www.duckdns.org after logging in).
# Needed by Caddy to solve the DNS-01 challenge by creating a TXT record.
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# ZeroSSL API access key.
# Get it at: https://app.zerossl.com -> Developer -> API Key -> Generate.
ZEROSSL_API_KEY=your-zerossl-api-key

# Flask session secret — any random string.
FLASK_SECRET=change-me-to-a-random-string
